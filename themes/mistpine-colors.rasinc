/**
 * mistpine-colors: the mistpine colors for rofi 1.7.5+, without a layout.
 * https://github.com/mistpine/mistpine.rofi · MIT License
 *
 * Save this file in ~/.local/share/rofi/themes/ and import it by its
 * full path, from config.rasi (after any @theme) or your own theme:
 *   @import "~/.local/share/rofi/themes/mistpine-colors.rasinc"
 * rofi 1.7 cannot find a .rasinc file by name, so keep the full path.
 *
 * It sets the standard rofi color variables (background, foreground,
 * selected-normal-background, …) and mistpine-* names for the palette.
 *
 * Generated by scripts/generate.ts from the mistpine spec
 * (https://github.com/mistpine/mistpine/blob/main/palette/mistpine.json).
 * Do not edit by hand.
 */

* {
    /* The mistpine palette. */
    mistpine-bg0:                 #071921;
    mistpine-bg1:                 #0b1f27;
    mistpine-bg2:                 #0f272e;
    mistpine-bg3:                 #152f37;
    mistpine-bg4:                 #26414a;
    mistpine-fg0:                 #4e6570;
    mistpine-fg1:                 #8796a0;
    mistpine-fg2:                 #a7b0bb;
    mistpine-fg3:                 #c4c9d0;
    mistpine-red:                 #be7356;
    mistpine-orange:              #c98b56;
    mistpine-yellow:              #c2a55b;
    mistpine-green:               #8a9a5b;
    mistpine-cyan:                #5f9a96;
    mistpine-blue:                #6f8fa8;
    mistpine-purple:              #8c84b4;
    mistpine-pink:                #c08a9c;
    mistpine-bright-red:          #d08a6e;
    mistpine-bright-green:        #a9b97a;
    mistpine-bright-yellow:       #dcc27e;
    mistpine-bright-blue:         #93afc4;
    mistpine-bright-purple:       #b8a8c6;
    mistpine-bright-cyan:         #86bcb6;

    /* Canvas: floating windows recede to bg0, as Neovim's floats and pickers
     * do; text is fg3; borders and separators are bg4. */
    background:                   var(mistpine-bg0);
    foreground:                   var(mistpine-fg3);
    border-color:                 var(mistpine-bg4);
    separatorcolor:               var(mistpine-bg4);
    scrollbar-handle:             var(mistpine-bg4);

    /* Rows: no zebra striping, so alternate rows equal normal ones. */
    normal-background:            var(mistpine-bg0);
    normal-foreground:            var(mistpine-fg3);
    alternate-normal-background:  var(mistpine-bg0);
    alternate-normal-foreground:  var(mistpine-fg3);

    /* The selected row: bg3, the spec's selection, under fg3. */
    selected-normal-background:   var(mistpine-bg3);
    selected-normal-foreground:   var(mistpine-fg3);

    /* Active rows (dmenu -a, focused windows) are yellow, as marked entries
     * in Neovim's pickers. */
    active-background:            var(mistpine-bg0);
    active-foreground:            var(mistpine-yellow);
    alternate-active-background:  var(mistpine-bg0);
    alternate-active-foreground:  var(mistpine-yellow);
    selected-active-background:   var(mistpine-bg3);
    selected-active-foreground:   var(mistpine-yellow);

    /* Urgent rows (dmenu -u, windows asking for attention) are red. Red is
     * too dark on the selection (3.9:1), so a selected urgent row is filled. */
    urgent-background:            var(mistpine-bg0);
    urgent-foreground:            var(mistpine-red);
    alternate-urgent-background:  var(mistpine-bg0);
    alternate-urgent-foreground:  var(mistpine-red);
    selected-urgent-background:   var(mistpine-red);
    selected-urgent-foreground:   var(mistpine-bg0);

    /* mistpine's own roles, used by themes/mistpine.rasi: the prompt in the
     * accent, counters and placeholders muted, the selection caret and
     * matches in orange, messages like a status line, errors in red. */
    mistpine-prompt:              var(mistpine-blue);
    mistpine-muted:               var(mistpine-fg1);
    mistpine-caret:               var(mistpine-orange);
    mistpine-match:               var(mistpine-orange);
    mistpine-message-background:  var(mistpine-bg2);
    mistpine-message-foreground:  var(mistpine-fg2);
    mistpine-error:               var(mistpine-red);

    /* Matched characters: bold orange (4.9:1 even on the selection). */
    highlight:                    bold #c98b56;
}
