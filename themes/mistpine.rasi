/**
 * mistpine: the mistpine color scheme for rofi 1.7.5+.
 * https://github.com/mistpine/mistpine.rofi · MIT License
 *
 * Save this file as ~/.local/share/rofi/themes/mistpine.rasi, then add
 * @theme "mistpine" to the end of ~/.config/rofi/config.rasi (or pick
 * it in rofi-theme-selector).
 *
 * Generated by scripts/generate.ts from the mistpine spec
 * (https://github.com/mistpine/mistpine/blob/main/palette/mistpine.json)
 * and src/layout.rasi. Do not edit by hand.
 */

* {
    /* The mistpine palette. */
    mistpine-bg0:                 #071921;
    mistpine-bg1:                 #0b1f27;
    mistpine-bg2:                 #0f272e;
    mistpine-bg3:                 #152f37;
    mistpine-bg4:                 #26414a;
    mistpine-fg0:                 #4e6570;
    mistpine-fg1:                 #8796a0;
    mistpine-fg2:                 #a7b0bb;
    mistpine-fg3:                 #c4c9d0;
    mistpine-red:                 #be7356;
    mistpine-orange:              #c98b56;
    mistpine-yellow:              #c2a55b;
    mistpine-green:               #8a9a5b;
    mistpine-cyan:                #5f9a96;
    mistpine-blue:                #6f8fa8;
    mistpine-purple:              #8c84b4;
    mistpine-pink:                #c08a9c;
    mistpine-bright-red:          #d08a6e;
    mistpine-bright-green:        #a9b97a;
    mistpine-bright-yellow:       #dcc27e;
    mistpine-bright-blue:         #93afc4;
    mistpine-bright-purple:       #b8a8c6;
    mistpine-bright-cyan:         #86bcb6;

    /* Canvas: floating windows recede to bg0, as Neovim's floats and pickers
     * do; text is fg3; borders and separators are bg4. */
    background:                   var(mistpine-bg0);
    foreground:                   var(mistpine-fg3);
    border-color:                 var(mistpine-bg4);
    separatorcolor:               var(mistpine-bg4);
    scrollbar-handle:             var(mistpine-bg4);

    /* Rows: no zebra striping, so alternate rows equal normal ones. */
    normal-background:            var(mistpine-bg0);
    normal-foreground:            var(mistpine-fg3);
    alternate-normal-background:  var(mistpine-bg0);
    alternate-normal-foreground:  var(mistpine-fg3);

    /* The selected row: bg3, the spec's selection, under fg3. */
    selected-normal-background:   var(mistpine-bg3);
    selected-normal-foreground:   var(mistpine-fg3);

    /* Active rows (dmenu -a, focused windows) are yellow, as marked entries
     * in Neovim's pickers. */
    active-background:            var(mistpine-bg0);
    active-foreground:            var(mistpine-yellow);
    alternate-active-background:  var(mistpine-bg0);
    alternate-active-foreground:  var(mistpine-yellow);
    selected-active-background:   var(mistpine-bg3);
    selected-active-foreground:   var(mistpine-yellow);

    /* Urgent rows (dmenu -u, windows asking for attention) are red. Red is
     * too dark on the selection (3.9:1), so a selected urgent row is filled. */
    urgent-background:            var(mistpine-bg0);
    urgent-foreground:            var(mistpine-red);
    alternate-urgent-background:  var(mistpine-bg0);
    alternate-urgent-foreground:  var(mistpine-red);
    selected-urgent-background:   var(mistpine-red);
    selected-urgent-foreground:   var(mistpine-bg0);

    /* mistpine's own roles, used by themes/mistpine.rasi: the prompt in the
     * accent, counters and placeholders muted, the selection caret and
     * matches in orange, messages like a status line, errors in red. */
    mistpine-prompt:              var(mistpine-blue);
    mistpine-muted:               var(mistpine-fg1);
    mistpine-caret:               var(mistpine-orange);
    mistpine-match:               var(mistpine-orange);
    mistpine-message-background:  var(mistpine-bg2);
    mistpine-message-foreground:  var(mistpine-fg2);
    mistpine-error:               var(mistpine-red);

    /* Matched characters: bold orange (4.9:1 even on the selection). */
    highlight:                    bold #c98b56;
}

* {
    mistpine-width:  40em;
    mistpine-radius: 8px;

    background-color: transparent;
    text-color:       var(foreground);
}

window {
    location:         center;
    anchor:           center;
    width:            var(mistpine-width);
    border:           1px;
    border-radius:    var(mistpine-radius);
    border-color:     var(border-color);
    background-color: var(background);
    padding:          0;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing:  0;
    padding:  0;
}

/* Prompt, filter and counter: like a picker's prompt line. */

inputbar {
    children:     [ prompt, textbox-prompt-colon, entry, num-filtered-rows, textbox-num-sep, num-rows, case-indicator ];
    spacing:      0;
    padding:      0.75em 1em;
    border:       0 0 1px 0;
    border-color: var(separatorcolor);
}

prompt {
    text-color: var(mistpine-prompt);
}

textbox-prompt-colon {
    str:        "❯";
    expand:     false;
    margin:     0 0.5em;
    text-color: var(mistpine-prompt);
}

entry {
    placeholder:       "Search";
    placeholder-color: var(mistpine-muted);
    text-color:        var(foreground);
    cursor:            text;
}

num-filtered-rows, textbox-num-sep, num-rows, case-indicator {
    expand:     false;
    text-color: var(mistpine-muted);
}

textbox-num-sep {
    str: "/";
}

case-indicator {
    margin: 0 0 0 0.5em;
}

/* Messages (-mesg) sit on a raised surface, like a status line. */

message {
    padding:          0.5em 1em;
    border:           0 0 1px 0;
    border-color:     var(separatorcolor);
    background-color: var(mistpine-message-background);
}

textbox {
    text-color: var(mistpine-message-foreground);
}

/* Errors (rofi -e) get a red border. */

error-message {
    padding:          1em;
    border:           1px;
    border-radius:    var(mistpine-radius);
    border-color:     var(mistpine-error);
    background-color: var(background);
}

error-message textbox {
    text-color: var(foreground);
}

/* The list. */

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    scrollbar:    true;
    spacing:      0.25em;
    padding:      0.5em;
    border:       0;
}

scrollbar {
    width:        4px;
    handle-width: 4px;
    handle-color: var(scrollbar-handle);
    border:       0;
    padding:      0;
    margin:       0 0 0 0.5em;
}

element {
    spacing:       0.75em;
    padding:       0.4em 0.75em;
    border:        0 0 0 2px;
    border-radius: 4px;
    border-color:  transparent;
    cursor:        pointer;
}

element normal.normal {
    background-color: var(normal-background);
    text-color:       var(normal-foreground);
    highlight:        var(highlight);
}

element alternate.normal {
    background-color: var(alternate-normal-background);
    text-color:       var(alternate-normal-foreground);
    highlight:        var(highlight);
}

element normal.active {
    background-color: var(active-background);
    text-color:       var(active-foreground);
    highlight:        var(highlight);
}

element alternate.active {
    background-color: var(alternate-active-background);
    text-color:       var(alternate-active-foreground);
    highlight:        var(highlight);
}

element normal.urgent {
    background-color: var(urgent-background);
    text-color:       var(urgent-foreground);
    highlight:        var(highlight);
}

element alternate.urgent {
    background-color: var(alternate-urgent-background);
    text-color:       var(alternate-urgent-foreground);
    highlight:        var(highlight);
}

/* The selected row: a raised background and an orange caret on the left. */

element selected.normal {
    background-color: var(selected-normal-background);
    text-color:       var(selected-normal-foreground);
    border-color:     var(mistpine-caret);
    highlight:        var(highlight);
}

element selected.active {
    background-color: var(selected-active-background);
    text-color:       var(selected-active-foreground);
    border-color:     var(mistpine-caret);
    highlight:        var(highlight);
}

/* Filled red: matches use the row's own text color, underlined. */
element selected.urgent {
    background-color: var(selected-urgent-background);
    text-color:       var(selected-urgent-foreground);
    border-color:     var(selected-urgent-background);
    highlight:        bold underline;
}

element-icon {
    size:             1.25em;
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}

/* Modes (drun, run, window, …) along the bottom, as tabs. No border or
 * padding of its own: dmenu has no modes, and an empty strip would show. */

mode-switcher {
    spacing: 0.5em;
    margin:  0 0.5em;
    padding: 0;
    border:  0;
}

button {
    padding:       0.4em;
    margin:        0 0 0.5em 0;
    border-radius: 4px;
    text-color:    var(mistpine-muted);
    cursor:        pointer;
}

/* The current mode looks like the selected row. */
button selected {
    background-color: var(selected-normal-background);
    text-color:       var(selected-normal-foreground);
}
